# Server-only deployment mode: development, test, or production.
NODEFLOW_ENV=development

# Comma-separated browser origins. Production startup requires at least one.
NODEFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-only Groq configuration. Never prefix these values with VITE_.
# Create a free Groq project API key and add the same secret in Vercel.
NODEFLOW_AI_MODEL=openai/gpt-oss-20b
NODEFLOW_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters-in-production
# GROQ_API_KEY=

# JavaScript nodes execute only in Vercel Sandbox. Vercel deployment and
# `vercel dev` supply short-lived OIDC automatically. For direct local
# FastAPI execution, configure all three server-only values below instead.
# Do not copy an OIDC token into a checked-in or long-lived local env file.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
